# ==============================================================================
# MariaDB HA v2.0 - Distributed Topology Config
# ==============================================================================

# [Node Identity]
# 填入 3 台宿主机的真实 IP (必须互通)
# Node-1: Master + ProxySQL + Adminer
NODE_1_IP="192.168.1.10"

# Node-2/3: Slaves
NODE_2_IP="192.168.1.11"
NODE_3_IP="192.168.1.12"

# [Service Ports]
# 宿主机暴露端口
DB_PORT=3306
PROXY_ADMIN_PORT=6032
PROXY_QUERY_PORT=6033
ADMINER_PORT=8080

# [Images]
# 追求最新技术栈
MARIADB_IMAGE="mariadb:latest"
PROXYSQL_IMAGE="proxysql/proxysql:latest"
ADMINER_IMAGE="adminer:latest"

# [Users]
# 仅定义用户名，密码在安装时交互输入
REPL_USER="repl_user"
APP_USER="app"
MONITOR_USER="monitor"
